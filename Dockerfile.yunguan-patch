# 基于现有运行镜像打补丁 - 添加运管认证功能
FROM 10.200.93.79:15080/gyjc/litellm:v1.85.0-38276fb

# 运管认证补丁说明:
# - yunguan_auth.py: 新增运管认证模块
# - user_api_key_auth.py: 在标准认证失败后调用运管认证兜底

# 复制到 venv 安装路径 (Python 3.13)
COPY litellm/proxy/auth/yunguan_auth.py /app/.venv/lib/python3.13/site-packages/litellm/proxy/auth/yunguan_auth.py
COPY litellm/proxy/auth/user_api_key_auth.py /app/.venv/lib/python3.13/site-packages/litellm/proxy/auth/user_api_key_auth.py

# 复制到备用路径 (/app/litellm/)
COPY litellm/proxy/auth/yunguan_auth.py /app/litellm/proxy/auth/yunguan_auth.py
COPY litellm/proxy/auth/user_api_key_auth.py /app/litellm/proxy/auth/user_api_key_auth.py

# 删除旧 .pyc 缓存文件，确保 Python 重新编译
RUN find /app -name "__pycache__" -type d -exec rm -rf {} + 2>/dev/null || true

# 验证文件内容
RUN grep -c "运管认证" /app/.venv/lib/python3.13/site-packages/litellm/proxy/auth/user_api_key_auth.py

# 设置入口点
ENTRYPOINT ["docker/prod_entrypoint.sh"]
CMD ["--config", "/app/config.yaml", "--port", "4000"]